{
  "name": "earpiece-app",
  "productName": "Earpiece",
  "version": "0.4.3",
  "private": true,
  "description": "Mac app for earpiece: the command center for all your agents.",
  "type": "module",
  "main": "main/main.mjs",
  "author": "Aditya Vernekar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac --universal",
    "dist:arm64": "electron-builder --mac --arm64",
    "bench": "node ../scripts/bench-hook.mjs --electron \"$PWD/dist/mac-universal/Earpiece.app/Contents/MacOS/Earpiece\""
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.earpiece.mac",
    "protocols": [
      {
        "name": "Earpiece",
        "schemes": [
          "earpiece"
        ]
      }
    ],
    "productName": "Earpiece",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "build/tray*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "core/src"
      },
      {
        "from": "../bin",
        "to": "core/bin"
      },
      {
        "from": "../package.json",
        "to": "core/package.json"
      },
      {
        "from": "../pro",
        "to": "pro",
        "filter": [
          "**/*",
          "!test/**",
          "!eval/**",
          "!native/*.swift"
        ]
      },
      {
        "from": "../pro/node_modules",
        "to": "pro/node_modules"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "x64ArchFiles": "Contents/Resources/pro/node_modules/node-pty/prebuilds/**",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "MIT License",
        "NSAppleEventsUsageDescription": "Earpiece brings forward the iTerm2 or Terminal tab your agent is running in when you click its card.",
        "NSMicrophoneUsageDescription": "Earpiece uses the microphone only while you hold the mic button in the notch, to turn your spoken reply to an agent into text."
      }
    },
    "dmg": {
      "sign": false,
      "title": "Earpiece"
    },
    "publish": null
  }
}
